# CineRoulette Environment Variables
# Fill these values in your local .env file

# Groq AI Configuration (get a key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# TMDB (The Movie Database) — optional, free key at https://www.themoviedb.org/settings/api
# Used to fetch a real poster for each recommendation. Without it, the app
# automatically falls back to a stylized terminal placeholder — no crash, no setup required.
TMDB_API_KEY=your-tmdb-api-key
